# Kopier til .env.local og fyll inn.

# --- Offentlige verdier (trygge i nettleseren) ---
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://DITT-PROSJEKT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Adressen appen kjører på (brukes i metadata og som reserve for lenker).
NEXT_PUBLIC_SITE_URL=https://vistiller.com

# --- Hemmelige verdier (bare på serveren – aldri NEXT_PUBLIC_) ---
# Betalingsmuren er AV til både STRIPE_SECRET_KEY og SUPABASE_SECRET_KEY er satt.

# Stripe → Developers → API keys (sk_test_... under testing, sk_live_... i produksjon)
STRIPE_SECRET_KEY=
# Stripe → Developers → Webhooks → endepunktet → Signing secret (whsec_...)
STRIPE_WEBHOOK_SECRET=
# Valgfri: bruk en pris du har laget i Stripe (price_...). Tom = 499 kr/år inkl. mva lages automatisk.
# Lager du prisen selv, må den settes til «Inkludert i prisen» under avgift i Stripe.
STRIPE_PRICE_ID=
# Valgfri: sett til true når Stripe Tax er satt opp. Da vises mva-andelen på kvitteringen.
STRIPE_AUTOMATIC_TAX=

# Supabase → Project Settings → API → secret key. Brukes kun til å lagre
# medlemskapsstatus når Stripe bekrefter en betaling.
SUPABASE_SECRET_KEY=
