# Kopier til .env.local og fyll inn. Ingen av disse er hemmelige –
# appen bruker ikke Supabase sin secret/service-role-nøkkel.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://DITT-PROSJEKT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Adressen appen kjører på (brukes i metadata og som reserve for lenker).
NEXT_PUBLIC_SITE_URL=https://vistiller.com
